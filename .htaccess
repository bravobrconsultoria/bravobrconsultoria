Options -Indexes -MultiViews
# HTML routes may share names with old deployment directories.
# Keep mod_dir from adding a slash before the explicit route is served.
DirectorySlash Off
RewriteEngine On

# Canonical public URLs; source HTML files stay at the project root.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(foods|empresarial)\.html[\s?] [NC]
RewriteRule ^(foods|empresarial)\.html$ /$1 [R=301,L]
RewriteRule ^(foods|empresarial)/$ /$1 [R=301,L]
RewriteRule ^(foods|empresarial)$ $1.html [END]

RewriteCond %{THE_REQUEST} \s/+section-index-sobre\.html[\s?] [NC]
RewriteRule ^section-index-sobre\.html$ /sobre [R=301,L]
RewriteRule ^sobre/$ /sobre [R=301,L]
RewriteRule ^sobre$ section-index-sobre.html [END]
RewriteCond %{THE_REQUEST} \s/+section-index-metodo\.html[\s?] [NC]
RewriteRule ^section-index-metodo\.html$ /metodo [R=301,L]
RewriteRule ^metodo/$ /metodo [R=301,L]
RewriteRule ^metodo$ section-index-metodo.html [END]
RewriteCond %{THE_REQUEST} \s/+section-index-solucoes\.html[\s?] [NC]
RewriteRule ^section-index-solucoes\.html$ /solucoes [R=301,L]
RewriteRule ^solucoes/$ /solucoes [R=301,L]
RewriteRule ^solucoes$ section-index-solucoes.html [END]
RewriteCond %{THE_REQUEST} \s/+section-index-cases\.html[\s?] [NC]
RewriteRule ^section-index-cases\.html$ /cases [R=301,L]
RewriteRule ^cases/$ /cases [R=301,L]
RewriteRule ^cases$ section-index-cases.html [END]
RewriteCond %{THE_REQUEST} \s/+section-index-contato\.html[\s?] [NC]
RewriteRule ^section-index-contato\.html$ /contato [R=301,L]
RewriteRule ^contato/$ /contato [R=301,L]
RewriteRule ^contato$ section-index-contato.html [END]
RewriteCond %{THE_REQUEST} \s/+section-index-visao\.html[\s?] [NC]
RewriteRule ^section-index-visao\.html$ /visao [R=301,L]
RewriteRule ^visao/$ /visao [R=301,L]
RewriteRule ^visao$ section-index-visao.html [END]
RewriteCond %{THE_REQUEST} \s/+section-index-especializacoes\.html[\s?] [NC]
RewriteRule ^section-index-especializacoes\.html$ /especializacoes [R=301,L]
RewriteRule ^especializacoes/$ /especializacoes [R=301,L]
RewriteRule ^especializacoes$ section-index-especializacoes.html [END]
RewriteCond %{THE_REQUEST} \s/+section-foods-cardapio\.html[\s?] [NC]
RewriteRule ^section-foods-cardapio\.html$ /foods/cardapio [R=301,L]
RewriteRule ^foods/cardapio/$ /foods/cardapio [R=301,L]
RewriteRule ^foods/cardapio$ section-foods-cardapio.html [END]
RewriteCond %{THE_REQUEST} \s/+section-foods-delivery\.html[\s?] [NC]
RewriteRule ^section-foods-delivery\.html$ /foods/delivery [R=301,L]
RewriteRule ^foods/delivery/$ /foods/delivery [R=301,L]
RewriteRule ^foods/delivery$ section-foods-delivery.html [END]
RewriteCond %{THE_REQUEST} \s/+section-foods-desafios\.html[\s?] [NC]
RewriteRule ^section-foods-desafios\.html$ /foods/desafios [R=301,L]
RewriteRule ^foods/desafios/$ /foods/desafios [R=301,L]
RewriteRule ^foods/desafios$ section-foods-desafios.html [END]
RewriteCond %{THE_REQUEST} \s/+section-foods-cases\.html[\s?] [NC]
RewriteRule ^section-foods-cases\.html$ /foods/cases [R=301,L]
RewriteRule ^foods/cases/$ /foods/cases [R=301,L]
RewriteRule ^foods/cases$ section-foods-cases.html [END]
RewriteCond %{THE_REQUEST} \s/+section-foods-sobre\.html[\s?] [NC]
RewriteRule ^section-foods-sobre\.html$ /foods/sobre [R=301,L]
RewriteRule ^foods/sobre/$ /foods/sobre [R=301,L]
RewriteRule ^foods/sobre$ section-foods-sobre.html [END]
RewriteCond %{THE_REQUEST} \s/+section-empresarial-jornada\.html[\s?] [NC]
RewriteRule ^section-empresarial-jornada\.html$ /empresarial/jornada [R=301,L]
RewriteRule ^empresarial/jornada/$ /empresarial/jornada [R=301,L]
RewriteRule ^empresarial/jornada$ section-empresarial-jornada.html [END]
RewriteCond %{THE_REQUEST} \s/+section-empresarial-desafios\.html[\s?] [NC]
RewriteRule ^section-empresarial-desafios\.html$ /empresarial/desafios [R=301,L]
RewriteRule ^empresarial/desafios/$ /empresarial/desafios [R=301,L]
RewriteRule ^empresarial/desafios$ section-empresarial-desafios.html [END]
RewriteCond %{THE_REQUEST} \s/+section-empresarial-cases\.html[\s?] [NC]
RewriteRule ^section-empresarial-cases\.html$ /empresarial/cases [R=301,L]
RewriteRule ^empresarial/cases/$ /empresarial/cases [R=301,L]
RewriteRule ^empresarial/cases$ section-empresarial-cases.html [END]
RewriteCond %{THE_REQUEST} \s/+section-empresarial-sobre\.html[\s?] [NC]
RewriteRule ^section-empresarial-sobre\.html$ /empresarial/sobre [R=301,L]
RewriteRule ^empresarial/sobre/$ /empresarial/sobre [R=301,L]
RewriteRule ^empresarial/sobre$ section-empresarial-sobre.html [END]

# Deploy only public files listed in README.md.
ErrorDocument 404 /404.html
